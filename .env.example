# ============================================
# FLASK CONFIGURATION
# ============================================
SECRET_KEY=your_secret_key_here_change_in_production_2025
FLASK_ENV=production
DEBUG=False

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# ============================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ============================================
MONGO_URI=mongodb+srv://user:password@cluster0.ps5lrai.mongodb.net/AI_interview?retryWrites=true&w=majority
MONGO_USER=user
MONGO_PASSWORD=password

# ============================================
# AI/ML API KEYS
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=persona-nexus
DOCKER_IMAGE_TAG=latest

# ============================================
# JENKINS CONFIGURATION
# ============================================
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token

# ============================================
# APPLICATION SETTINGS
# ============================================
FLASK_APP=run.py
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================
# NGINX CONFIGURATION
# ============================================
NGINX_ENV=production
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/persona-nexus/app.log

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=https://your_sentry_dsn_here
DATADOG_API_KEY=your_datadog_api_key
